{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "plan": {
      "model": "openai/gpt-5.5-fast"
    },
    "build": {
      "model": "openai/gpt-5.5-fast"
    },
    "general": {
      "model": "openai/gpt-5.5"
    },
    "explore": {
      "model": "openai/gpt-5.5-fast"
    },
    "scout": {
      "model": "openai/gpt-5.5-fast"
    },
    "title": {
      "model": "zai-coding-plan/glm-5.1"
    },
    "summary": {
      "model": "zai-coding-plan/glm-5.1"
    },
    "compaction": {
      "model": "openai/gpt-5.5-fast"
    }
  },
  "model": "zai-coding-plan/glm-5.1",
  "small_model": "zai-coding-plan/glm-5.1",
  "mcp": {
     "socraticode": {
      "type": "local",
      "command": ["npx", "-y", "socraticode"],
      "enabled": true
    },
    "MotherDuck": {
      "type": "remote",
      "url": "https://api.motherduck.com/mcp"
    }
  },
  "share": "disabled",
  "snapshot": false,
  "compaction": {
    "auto": true,
    "prune": true
  },
  "experimental": {
    "mcp_lazy": true,
    "disable_paste_summary": true
  },
  "plugin": [
    "@z3z1ma/open-loom-core@0.2.1",
    "@z3z1ma/open-loom-playbook@0.2.1"
  ]
}
