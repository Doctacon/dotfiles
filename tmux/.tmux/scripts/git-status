#!/bin/sh

dir=$1
[ -n "$dir" ] || exit 0
cd "$dir" 2>/dev/null || exit 0

branch=$(GIT_OPTIONAL_LOCKS=0 git rev-parse --abbrev-ref HEAD 2>/dev/null) || exit 0
[ "$branch" = "HEAD" ] && branch=$(GIT_OPTIONAL_LOCKS=0 git rev-parse --short HEAD 2>/dev/null || printf detached)

dirty=0
GIT_OPTIONAL_LOCKS=0 git diff --quiet --ignore-submodules -- 2>/dev/null || dirty=1
GIT_OPTIONAL_LOCKS=0 git diff --cached --quiet --ignore-submodules -- 2>/dev/null || dirty=1
if [ "$dirty" -eq 0 ]; then
  if [ -n "$(GIT_OPTIONAL_LOCKS=0 git ls-files --others --exclude-standard 2>/dev/null | head -n 1)" ]; then
    dirty=1
  fi
fi

if [ "$dirty" -eq 1 ]; then
  printf '#[fg=#f97316] %s*' "$branch"
else
  printf '#[fg=#0f766e] %s' "$branch"
fi
